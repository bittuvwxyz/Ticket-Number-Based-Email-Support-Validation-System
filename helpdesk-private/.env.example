# -----------------------------------------------------------------------------
# Ticket-Based Email Support & Validation System Configuration
# -----------------------------------------------------------------------------

# Application
APP_NAME="Secure Ticket Support"
APP_ENV="development" # development | production
APP_KEY="change_this_to_a_random_32_character_secret_key"
APP_DEBUG=true
APP_URL="http://localhost/helpdesk"
APP_TIMEZONE="UTC"

# Database Configuration (MySQL / MariaDB)
DB_HOST="127.0.0.1"
DB_PORT="3306"
DB_DATABASE="helpdesk_db"
DB_USERNAME="root"
DB_PASSWORD=""
DB_CHARSET="utf8mb4"
DB_COLLATION="utf8mb4_unicode_ci"

# Inbound Mail (IMAP) Configuration
MAIL_IMAP_HOST="mail.example.com"
MAIL_IMAP_PORT=993
MAIL_IMAP_ENCRYPTION="ssl" # ssl | tls | none
MAIL_IMAP_USERNAME="support@example.com"
MAIL_IMAP_PASSWORD="secure_email_password"
MAIL_IMAP_VALIDATE_CERT=true

# Outbound Mail (SMTP / PHPMailer) Configuration
MAIL_SMTP_HOST="mail.example.com"
MAIL_SMTP_PORT=587
MAIL_SMTP_ENCRYPTION="tls" # tls | ssl | none
MAIL_SMTP_AUTH=true
MAIL_SMTP_USERNAME="support@example.com"
MAIL_SMTP_PASSWORD="secure_email_password"
MAIL_FROM_ADDRESS="support@example.com"
MAIL_FROM_NAME="Support Desk"

# Reply Routing & Token Settings
# Incoming replies are addressed to e.g.: reply+{token}@{MAIL_REPLY_DOMAIN}
MAIL_REPLY_DOMAIN="example.com"
MAIL_REPLY_PREFIX="reply+"
MAIL_TOKEN_EXPIRY_DAYS=14
MAIL_TOKEN_LENGTH_BYTES=32

# Ticket Settings
TICKET_PREFIX="REQ"
TICKET_ALLOW_CLOSED_REPLIES=false # If false, emails to closed tickets generate rejection or new ticket based on policy
TICKET_REOPEN_WINDOW_DAYS=5
TICKET_AUTO_EXPIRE_DAYS=30
